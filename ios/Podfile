# Force platform to iOS 13.0
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :project,
  'Release' => :project,
  'Profile' => :project,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)

  # ✅ Fix: If file is corrupted or has Windows paths, try to find FLUTTER_ROOT from env
  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      matches = line.match(/\AFLUTTER_ROOT=(.*)\z/)
      if matches
        path = matches[1].strip
        # If it's a Windows path, ignore it and look for environment variable
        return path unless path.include?('\\') || path.include?('C:')
      end
    end
  end

  # Fallback to environment variable (set by Flutter tool on macOS)
  return ENV['FLUTTER_ROOT'] if ENV['FLUTTER_ROOT']

  raise "FLUTTER_ROOT not found. Please ensure flutter pub get is executed first."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'xcode_backend.rb'), flutter_root)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
